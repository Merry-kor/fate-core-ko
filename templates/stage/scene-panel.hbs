<div class="fate-scene-panel__inner">
  <div class="fate-scene-panel__header">
    <span class="fate-scene-panel__scene-name">
      <i class="fa fa-map"></i> {{#if sceneName}}{{sceneName}}{{else}}장면 없음{{/if}}
    </span>
    {{#if hasScene}}
    <button type="button" class="fate-scene-add" data-scene-action="add"
      title="장면 면모 추가">+ 면모</button>
    {{/if}}
  </div>

  {{#if hasScene}}
    {{#if aspects.length}}
    <ul class="fate-scene-aspects">
      {{#each aspects as |aspect|}}
      <li class="fate-scene-aspect">
        <span class="fate-scene-aspect__bar"></span>
        <input class="fate-scene-aspect__input" type="text"
          value="{{aspect.label}}"
          data-scene-aspect-id="{{aspect.id}}"
          placeholder="장면 면모...">
        <div class="fate-scene-aspect__btns">
          <button type="button" data-scene-action="invoke" data-aspect-id="{{aspect.id}}"
            title="채팅에 표시"><i class="fa fa-comment"></i></button>
          <button type="button" data-scene-action="delete" data-aspect-id="{{aspect.id}}"
            title="삭제"><i class="fa fa-trash"></i></button>
        </div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="fate-scene-panel__empty">장면 면모가 없습니다.<br>+ 면모 버튼으로 추가하세요.</p>
    {{/if}}
  {{else}}
  <p class="fate-scene-panel__empty">활성화된 장면이 없습니다.</p>
  {{/if}}
</div>
