<div class="sg-sheet sg-stunt-sheet">
  <input class="sg-name" type="text" name="name" value="{{item.name}}" placeholder="스턴트 이름">
  <div class="sg-row2">
    <label>연계 기능 <input type="text" name="system.skill" value="{{system.skill}}" placeholder="예: 인지"></label>
    <label>보정 <input type="number" name="system.bonus" value="{{system.bonus}}"></label>
  </div>
  <label class="sg-full">소모 <input type="text" name="system.cost" value="{{system.cost}}" placeholder="예: 불씨 1 (비우면 없음)"></label>
  <label class="sg-full">설명
    <textarea name="system.description" rows="5">{{system.description}}</textarea>
  </label>
</div>
